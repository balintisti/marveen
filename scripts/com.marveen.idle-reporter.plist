<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.marveen.idle-reporter - a tetlen-jelento launchd egysege (kartya ee4163be).

  EZ A FAJL NINCS TELEPITVE, es szandekosan itt, a repoban all. A telepites
  (`launchctl bootstrap` / a ~/Library/LaunchAgents ala masolas) FELUGYELET
  NELKULI RENDSZERMUVELET, tehat Isti dontese - ugyanabban a kotegben, mint a
  6e6e40ce napindito-koteg.

  Telepiteshez:
      cp scripts/com.marveen.idle-reporter.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.marveen.idle-reporter.plist
  Eltavolitashoz:
      launchctl bootout gui/$(id -u)/com.marveen.idle-reporter

  MIERT KULON FOLYAMAT, ES NEM A DASHBOARDBAN EGY TIMER: mert epp azt az esetet
  kell tulelnie, amikor a node folyamat all. Egy oron beluli or nem or.

  StartInterval: 300 (5 perc). A kuszob 40 perc, tehat ennel surubb futas nem ad
  tobb informaciot, csak terhelest - a watchdog 60 mp-e ott indokolt, mert az
  masodperces esemenyekre valaszol. A jelento allapotot figyel, nem esemenyt.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marveen.idle-reporter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/isti/marveen/scripts/idle-reporter.py</string>
    </array>
    <!-- launchd alapertelmezett PATH-ja minimalis. A szkript maga csak a python
         standard konyvtarat hasznalja, de a python3 megtalalasahoz kell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <!-- RunAtLoad: NINCS. Egy betoltéskori azonnali futas a gep indulasakor
         tuzelne, amikor meg egyetlen agens sem termelt semmit - vagyis a
         legrosszabb pillanatban adna "a teljes flotta nema" riasztast. Az elso
         kor 5 perccel kesobb boven eleg. -->
    <key>StandardOutPath</key>
    <string>/Users/isti/.claude/channels/idle-reporter.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/isti/.claude/channels/idle-reporter.log</string>
</dict>
</plist>
