<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marveen.delta-crm-feedback-poll</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__MARVEEN_ROOT__/scripts/delta-crm-feedback-poll.py</string>
    </array>

    <!-- every 10 minutes: 6 of the endpoint's 60 requests/hour (card f8fb841c) -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>StandardOutPath</key>
    <string>__MARVEEN_ROOT__/store/feedback-poll.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__MARVEEN_ROOT__/store/feedback-poll.launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
