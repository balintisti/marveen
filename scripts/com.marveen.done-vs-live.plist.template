<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marveen.done-vs-live</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>__MARVEEN_ROOT__/scripts/done-vs-live.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__MARVEEN_ROOT__/store/done-vs-live.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__MARVEEN_ROOT__/store/done-vs-live.launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
