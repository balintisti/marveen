<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marveen.agent-reports-snapshot</string>
  <!-- card b511e460: agents/*/reports -> /Users/isti/Backups/agent-reports, local only -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__MARVEEN_ROOT__/scripts/agent-reports-snapshot.sh</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__MARVEEN_ROOT__/store/agent-reports-snapshot.log</string>
  <key>StandardErrorPath</key><string>__MARVEEN_ROOT__/store/agent-reports-snapshot.log</string>
</dict>
</plist>
